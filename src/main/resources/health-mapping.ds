local attributeValue(attributes, uid) =
  local matches = std.filter(
    function(attribute) attribute.attribute == uid,
    attributes
  );
  if std.length(matches) > 0 then
    matches[0].value
  else
    null;

local dataValue(dataValues, uid) =
  local matches = std.filter(
    function(dataValue) dataValue.dataElement == uid,
    dataValues
  );
  if std.length(matches) > 0 then
    matches[0].value
  else
    null;

local patients = std.map(
  function(patient)
    local attributes = patient.attributes;
    local firstName = attributeValue(attributes, "firstNameUID");
    local surname = attributeValue(attributes, "surnameUID");
    local dhisSex = attributeValue(attributes, "sexUID");
    local dob = attributeValue(attributes, "dobUID");

    local genderMap = {
      M: "male",
      F: "female",
      O: "other",
      Male: "male",
      Female: "female"
    };

    local gender =
      if dhisSex != null && std.objectHas(genderMap, dhisSex)
      then genderMap[dhisSex]
      else "unknown";

    std.prune({
      resourceType: "Patient",
      id: patient.trackedEntityInstance,
      identifier: [{
        system: "https://dhis2.example.org/trackedEntityInstances",
        value: patient.trackedEntityInstance
      }],
      name: [{
        text: firstName + " " + surname,
        family: surname,
        given: [firstName]
      }],
      gender: gender,
      birthDate: dob
    }),
  payload.trackedEntities
);

local bloodPressureObservations = std.map(
  function(event)
    local systolic = dataValue(event.dataValues, "systolicUID");
    local diastolic = dataValue(event.dataValues, "diastolicUID");

    if systolic != null || diastolic != null then {
      resourceType: "Observation",
      id: event.event + "-blood-pressure",
      status: "final",
      code: {
        coding: [{
          system: "http://loinc.org",
          code: "85354-9",
          display: "Blood pressure panel with all children optional"
        }],
        text: "Blood pressure"
      },
      subject: {
        reference: "Patient/" + event.trackedEntityInstance
      },
      effectiveDateTime: event.eventDate,
      component: std.filter(
        function(component) component != null,
        [
        if systolic != null then {
          code: {
            coding: [{
              system: "http://loinc.org",
              code: "8480-6",
              display: "Systolic blood pressure"
            }]
          },
          valueQuantity: if systolic != null then {
            value: std.parseInt(systolic),
            unit: "mmHg",
            system: "http://unitsofmeasure.org",
            code: "mm[Hg]"
          }
        } else null,
        if diastolic != null then {
          code: {
            coding: [{
              system: "http://loinc.org",
              code: "8462-4",
              display: "Diastolic blood pressure"
            }]
          },
          valueQuantity: if diastolic != null then {
            value: std.parseInt(diastolic),
            unit: "mmHg",
            system: "http://unitsofmeasure.org",
            code: "mm[Hg]"
          }
        } else null
        ]
      )
    } else null,
  payload.events
);

local heartRateObservations = std.map(
  function(event)
    local heartRate = dataValue(event.dataValues, "heartRateUID");

    if heartRate != null then {
      resourceType: "Observation",
      id: event.event + "-heart-rate",
      status: "final",
      code: {
        coding: [{
          system: "http://loinc.org",
          code: "8867-4",
          display: "Heart rate"
        }],
        text: "Heart rate"
      },
      subject: {
        reference: "Patient/" + event.trackedEntityInstance
      },
      effectiveDateTime: event.eventDate,
      valueQuantity: {
        value: std.parseInt(heartRate),
        unit: "beats/min",
        system: "http://unitsofmeasure.org",
        code: "/min"
      }
    } else null,
  payload.events
);

local validBloodPressureObservations = std.filter(
  function(observation) observation != null,
  bloodPressureObservations
);

local validHeartRateObservations = std.filter(
  function(observation) observation != null,
  heartRateObservations
);

local encounters = std.map(
  function(event) {
    resourceType: "Encounter",
    id: event.event + "-encounter",
    status: "finished",
    class: {
      system: "http://terminology.hl7.org/CodeSystem/v3-ActCode",
      code: "AMB",
      display: "ambulatory"
    },
    subject: {
      reference: "Patient/" + event.trackedEntityInstance
    },
    period: {
      start: event.eventDate
    }
  },
  payload.events
);

local resources =
  patients +
  encounters +
  validBloodPressureObservations +
  validHeartRateObservations;

{
  resourceType: "Bundle",
  type: "collection",
  entry: std.map(
    function(resource) {
      fullUrl: "https://health-sonnet.example.org/fhir/" +
               resource.resourceType + "/" + resource.id,
      resource: resource
    },
    resources
  )
}