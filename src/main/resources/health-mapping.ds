std.map(
  function(patient)
    local attributes = patient.attributes;
    local firstName = attributes[0].value;
    local surname = attributes[1].value;
    local sex = attributes[2].value;
    local dob = attributes[3].value;

    {
      resourceType: "Patient",
      id: patient.trackedEntityInstance,
      identifier: [{
        system: "https://dhis2.example.org/trackedEntityInstances",
        value: patient.trackedEntityInstance
      }],
      name: [{
        text: firstName + " " + surname,
        family: surname,
        given: [firstName]
      }],
      gender: sex,
      birthDate: dob
    },
  payload
)