local attributeValue(attributes, uid) = 
  std.filter(
    function(attribute) attribute.attribute == uid, attributes
  )[0].value;


std.map(
  function(patient)
    local attributes = patient.attributes;
    local firstName = attributeValue(attributes, "firstNameUID");
    local surname = attributeValue(attributes, "surnameUID");
    local sex = attributeValue(attributes, "sexUID");
    local dob = attributeValue(attributes, "dobUID");

    {
      resourceType: "Patient",
      id: patient.trackedEntityInstance,
      identifier: [{
        system: "https://dhis2.example.org/trackedEntityInstances",
        value: patient.trackedEntityInstance
      }],
      name: [{
        text: firstName + " " + surname,
        family: surname,
        given: [firstName]
      }],
      gender: sex,
      birthDate: dob
    },
  payload
)